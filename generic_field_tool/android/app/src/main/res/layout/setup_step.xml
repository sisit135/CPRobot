<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/setup_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setup_connection_body"
        android:textAppearance="@style/Setup.Body" />
    <LinearLayout
        android:id="@+id/setup_project_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/setup_project_name"
            android:text="@string/setup_project_name"
            android:textAppearance="@style/Setup.Body" />
        <EditText
            android:id="@+id/setup_project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
